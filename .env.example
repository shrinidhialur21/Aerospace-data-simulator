# Condense ENV Variables — Aerospace Simulator (Custom Input Connector)
# Set these in Condense → Connectors → Custom → Your Connector → Environment Variables

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_OUT=aerospace-data-demo
# Comma-separated list. One deployment can emit all three machine families.
ASSET_TYPES=aero_cnc,aero_cmm,aero_autoclave
CNC_COUNT=6
CMM_COUNT=2
AUTOCLAVE_COUNT=3
EMIT_INTERVAL_MS=3000
# Autoclave cycle clock: simulated minutes of cure cycle that elapse per tick
SIM_MIN_PER_TICK=2
SIMULATE_ANOMALY=true
PORT=3000
